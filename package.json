{
  "name": "bumdesma",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend --",
    "dev:all": "concurrently -k -n backend,frontend -c cyan,magenta \"npm run server\" \"npm run dev\"",
    "build": "npm run build --workspace frontend",
    "lint": "eslint frontend backend",
    "test": "npm run test --workspace backend",
    "preview": "npm run preview --workspace frontend --",
    "server": "npm run server --workspace backend",
    "migrate": "npm run migrate --workspace backend",
    "seed": "npm run seed --workspace backend",
    "seed:articles": "npm run seed:articles --workspace backend",
    "seed:content": "npm run seed:content --workspace backend",
    "reset-password": "npm run reset-password --workspace backend",
    "disable-2fa": "npm run disable-2fa --workspace backend"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0"
  }
}
