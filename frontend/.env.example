# Salin file ini menjadi frontend/.env (atau frontend/.env.local) lalu isi
# nilainya. JANGAN mengisi nilai asli di file ini.
#
# Analitik opsional (Umami/Plausible). Biarkan KEDUA nilai kosong untuk
# mematikan analitik: tanpa keduanya, tidak ada skrip yang dimuat.
# VITE_ANALYTICS_SRC wajib diawali https://, mis.
#   https://analytics.example.com/script.js
VITE_ANALYTICS_SRC=

# ID situs/website dari dasbor analitik. Dikirim sebagai atribut
# data-website-id pada elemen script.
VITE_ANALYTICS_SITE_ID=
