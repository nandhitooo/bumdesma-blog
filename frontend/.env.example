# Salin file ini menjadi frontend/.env HANYA bila API berada di origin lain.
# Selama API dilayani dari origin yang sama, file .env tidak diperlukan: semua
# permintaan memakai path relatif /api dan Vite (development) atau reverse proxy
# (produksi) yang meneruskannya ke server Express.

# Origin API, tanpa slash di akhir dan tanpa /api.
# Contoh: https://api.situs.id
# Bila kosong atau file ini tidak dibuat, frontend memakai path relatif
# (perilaku default). Dibaca saat build oleh frontend/src/lib/apiUrl.js,
# jadi `npm run build` perlu dijalankan ulang setelah nilainya diubah.
VITE_API_URL=
