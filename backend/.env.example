# Salin file ini menjadi backend/.env lalu isi nilainya.
# JANGAN commit file .env berisi nilai asli.

# Koneksi PostgreSQL, contoh: postgresql://user:password@localhost:5432/nama_database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/NAMA_DATABASE

# String acak panjang untuk menandatangani JWT, contoh cara membuat: openssl rand -hex 32
JWT_SECRET=GANTI_DENGAN_STRING_ACAK_PANJANG

# Origin frontend yang diizinkan mengakses API (tanpa slash di akhir).
# Boleh lebih dari satu, dipisah koma — mis. domain utama dan versi www-nya:
#   CLIENT_ORIGIN=https://situs.id,https://www.situs.id
CLIENT_ORIGIN=http://localhost:5173

# URL publik situs untuk robots.txt, sitemap.xml, feed RSS, dan pratinjau tautan.
# Tanpa slash di akhir dan wajib https saat NODE_ENV=production. Bila kosong,
# dipakai origin pertama dari CLIENT_ORIGIN.
PUBLIC_SITE_URL=http://localhost:5173

# Port server Express.
PORT=4000

# Percayai header X-Forwarded-For dari reverse proxy. Biarkan kosong bila server
# diakses langsung. Contoh nilai: 1 (satu hop) atau loopback.
TRUST_PROXY=

# Dipakai hanya oleh `npm run seed` untuk membuat user admin pertama.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT
